{
 "nombre": "Minuta",
 "id": "minuta",
 "datos": {
  "carpeta": "~/minuta"
 },
 "icono": "docs/favicon.svg",
 "plataformas": [
  "mac",
  "windows",
  "linux"
 ],
 "config": {
  "idioma_ui": [
   "es",
   "en"
  ],
  "ia": [
   "claude",
   "codex",
   "gemini"
  ],
  "idioma_audio": {
   "tipo": "texto",
   "patron": "auto|[a-z]{2,3}"
  },
  "modelo": [
   "turbo",
   "small"
  ]
 },
 "transcribir": {
  "modelos": "~/minuta/models"
 },
 "catalogo": {
  "repo": "minuta-app/minuta-catalogo",
  "rama": "main",
  "tipos": {
   "temas": {
    "validador": "universo_formato",
    "indice": "temas/index.json",
    "max_bytes": 102400,
    "max_indice": 2097152,
    "max_en_indice": 1000,
    "singular": "universo",
    "origen": false
   },
   "idiomas": {
    "validador": "idioma_formato",
    "indice": "idiomas/catalogo.json",
    "max_bytes": 204800,
    "max_indice": 4194304,
    "max_en_indice": 200,
    "singular": "idioma",
    "origen": false
   }
  }
 },
 "acciones": {
  "gimnasio": {
   "script": "gimnasio.py",
   "scriptDeLaApp": true,
   "args": [
    "$modo"
   ],
   "entrada": "archivo",
   "datos": {
    "modo": {
     "tipo": "enum",
     "valores": [
      "turno",
      "evaluar"
     ]
    },
    "*": "pasar"
   },
   "responde": "gym",
   "eco": [
    "modo"
   ],
   "limite": 330
  },
  "preguntar": {
   "script": "preguntar.py",
   "scriptDeLaApp": true,
   "args": [],
   "entrada": "archivo",
   "datos": {
    "id": {
     "tipo": "texto",
     "max": 80,
     "requerido": true
    },
    "pregunta": {
     "tipo": "texto",
     "max": 2000,
     "requerido": true
    }
   },
   "responde": "respuesta",
   "eco": [
    "id"
   ],
   "limite": 330
  }
 },
 "sin_acciones": [
  "catalogoInstalados",
  "catalogoQuitar",
  "catalogoUltima",
  "listaIA",
  "modelosVoz"
 ]
}
