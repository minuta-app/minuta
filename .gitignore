# Solo el código y los universos van al repo. Grabaciones, notas, modelos y datos personales se quedan en el computador.
/*
!/.gitignore
!/README.md
!/build.sh
!/perfil.ejemplo.json
!/CLAUDE.md
!/AGENTS.md
!/GEMINI.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/.claude/
!/herramientas/
!/instalar.sh
!/instalar.ps1
!/escritorio/
!/LICENSE
!/docs/
!/.github/
!/app/
!/bin/
!/ui/
!/universos/
!/pruebas/
!/ejemplos/
# Pieza: la descripción de la app y las piezas que usa (las leen bin/nucleo.py y pieza.py).
!/app.json
!/piezas.json
app/.build/
bin/minuta-diarizar
bin/minuta-diarizar.*
**/__pycache__/
*.log
.DS_Store
dist/
escritorio/node_modules/
escritorio/vendor/
capturas/
